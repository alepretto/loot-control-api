meta {
  name: Create Currency
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/currencies
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "code": "BRL",
    "label": "Real",
    "symbol": "R$"
  }
}

script:post-response {
  const data = res.body;
  if (data.id) {
    bru.setVar("currency_id", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
