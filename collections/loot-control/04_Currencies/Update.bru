meta {
  name: Update Currency
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/currencies/{{currency_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "code": "BRL",
    "label": "Real Brasileiro",
    "symbol": "R$"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
