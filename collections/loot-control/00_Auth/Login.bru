meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john@example.com",
    "password": "123456"
  }
}

script:post-response {
  const data = res.body;
  if (data.access_token) {
    bru.setVar("auth_token", data.access_token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
