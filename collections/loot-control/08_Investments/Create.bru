meta {
  name: Create Investment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/investments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "transaction_id": "{{transaction_id}}",
    "symbol": "PETR4.SA",
    "quantity": 100
  }
}

script:post-response {
  const data = res.body;
  if (data.id) {
    bru.setVar("investment_id", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
