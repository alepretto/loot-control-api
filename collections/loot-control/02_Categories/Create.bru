meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "label": "Alimentação",
    "nature": "variable"
  }
}

script:post-response {
  const data = res.body;
  if (data.id) {
    bru.setVar("category_id", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
