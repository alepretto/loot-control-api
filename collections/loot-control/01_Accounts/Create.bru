meta {
  name: Create Account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "label": "Nubank",
    "type": "bank"
  }
}

script:post-response {
  const data = res.body;
  if (data.id) {
    bru.setVar("account_id", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
