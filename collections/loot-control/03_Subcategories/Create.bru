meta {
  name: Create Subcategory
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/subcategories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "label": "Restaurante",
    "category_id": "{{category_id}}",
    "is_active": true
  }
}

script:post-response {
  const data = res.body;
  if (data.id) {
    bru.setVar("subcategory_id", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
